/* ChronosMesh — Dark Theme */
* { font-family: "Segoe UI", sans-serif; font-size: 10pt; }
QMainWindow, QWidget { background-color: #1E1E20; color: #E7E7E9; }
QListWidget#sidebarList { background-color: #18181A; border: none; border-right: 1px solid #2C2C2E; padding: 8px; }
QListWidget#sidebarList::item { padding: 10px 12px; border-radius: 6px; margin: 2px 4px; color: #C9C9CC; }
QListWidget#sidebarList::item:selected { background-color: #33345A; color: #A5B4FC; }
QListWidget#sidebarList::item:hover:!selected { background-color: #232326; }
QPushButton { background-color: #2A2A2D; color: #E7E7E9; border: 1px solid #3A3A3D; border-radius: 6px; padding: 6px 14px; }
QPushButton:hover { background-color: #333336; }
QPushButton#primaryButton { background-color: #6366F1; color: white; border: none; }
QGroupBox { border: 1px solid #333336; border-radius: 8px; margin-top: 12px; padding-top: 8px; color: #E7E7E9; }
QLineEdit, QTimeEdit, QDateEdit { background: #232326; color: #E7E7E9; border: 1px solid #3A3A3D; border-radius: 6px; padding: 4px 8px; }
QMenuBar { background-color: #18181A; color: #E7E7E9; border-bottom: 1px solid #2C2C2E; }
QStatusBar { background-color: #18181A; color: #C9C9CC; border-top: 1px solid #2C2C2E; }
